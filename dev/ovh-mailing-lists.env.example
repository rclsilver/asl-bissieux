# Production environment example only. Development Compose fixes dummy
# credentials and an OVH_ENDPOINT pointing at Smocker instead of reading .env.
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=REPLACE_ME
OVH_APPLICATION_SECRET=REPLACE_ME
OVH_CONSUMER_KEY=REPLACE_ME
APP_ML_DOMAIN=example.invalid
APP_ML_MEMBERS=membres
APP_ML_BUREAU=bureau
