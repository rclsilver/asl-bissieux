  "components": [
    {
      "name": "Connexion — action principale",
      "kind": "button",
      "refersTo": "button-primary-light",
      "description": "Traduction autonome de l’action de connexion. Les dimensions internes Material restent gérées par Material dans l’application.",
      "html": "<button type=\"button\" class=\"ds-primary\">Se connecter</button>",
      "css": ".ds-primary{background:var(--asl-primary,#124dc5);color:var(--asl-on-primary,#fff);border:0;border-radius:10px;min-height:48px;width:100%;padding:0 24px;font:500 .875rem/1.25rem \"Segoe UI\",Roboto,sans-serif;letter-spacing:0;cursor:pointer}.ds-primary:hover{background:color-mix(in srgb,var(--asl-primary,#124dc5),var(--asl-on-primary,#fff) 8%)}.ds-primary:focus-visible{outline:2px solid var(--asl-primary,#124dc5);outline-offset:3px}.ds-primary:active{background:color-mix(in srgb,var(--asl-primary,#124dc5),var(--asl-on-primary,#fff) 12%)}.ds-primary:disabled{cursor:default;color:color-mix(in srgb,var(--asl-ink,#142b48) 38%,transparent);background:color-mix(in srgb,var(--asl-ink,#142b48) 12%,transparent)}"
    },
    {
      "name": "Action secondaire du détail",
      "kind": "button",
      "description": "Lien à contour du détail d’un lot, avec retour à la ligne. Le texte est un libellé de composant.",
      "html": "<a href=\"#lot\" class=\"ds-outlined\">Consulter le lot</a>",
      "css": ".ds-outlined{display:inline-flex;align-items:center;min-height:44px;padding:12px;border:1px solid var(--asl-muted,#52697d);border-radius:10px;background:transparent;color:var(--asl-ink,#142b48);font:500 .875rem/1.25rem \"Segoe UI\",Roboto,sans-serif;letter-spacing:0;text-align:start;white-space:normal;text-decoration:underline;text-underline-offset:.22em}.ds-outlined:hover{background:var(--asl-tint,#e5efff);text-decoration-thickness:2px}.ds-outlined:focus-visible{outline:2px solid var(--asl-primary,#124dc5);outline-offset:3px}.ds-outlined:active{background:var(--asl-tint,#e5efff)}"
    },
    {
      "name": "Champ de recherche",
      "kind": "input",
      "refersTo": "field",
      "description": "Représentation statique du champ avec libellé. Le champ flottant, la validation et la géométrie interne sont fournis par Material dans l’application.",
      "html": "<label class=\"ds-field\">Rechercher un membre ou un lot<input class=\"ds-input\" type=\"search\" placeholder=\"Nom ou numéro de lot\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;width:100%;border-radius:10px 10px 0 0;background:var(--mat-sys-surface-variant,light-dark(#e0e2ec,#44474e));color:var(--asl-muted,#52697d);font:400 .875rem/1.25rem \"Segoe UI\",Roboto,sans-serif}.ds-input{min-width:0;width:100%;background:transparent;color:var(--asl-ink,#142b48);border:0;border-bottom:1px solid var(--asl-muted,#52697d);font:400 1rem/1.5rem \"Segoe UI\",Roboto,sans-serif;caret-color:var(--asl-primary,#124dc5)}.ds-input:hover{border-bottom-color:var(--asl-ink,#142b48)}.ds-input:focus-visible{outline:2px solid var(--asl-primary,#124dc5);outline-offset:3px;border-bottom-color:var(--asl-primary,#124dc5)}"
    },
    {
      "name": "Navigation Repères",
      "kind": "nav",
      "refersTo": "navigation-active-light",
      "description": "Liens du bandeau supérieur ; page active et focus utilisent leurs paires d’encre dédiées.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Menu principal\"><a class=\"ds-nav-link ds-nav-active\" href=\"#accueil\" aria-current=\"page\">Accueil</a><a class=\"ds-nav-link\" href=\"#budgets\">Budgets</a><a class=\"ds-nav-link\" href=\"#lots\">Lots</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:3px;background:var(--asl-header,#1246ae);color:var(--asl-header-ink,#fff);padding:14px 2rem;font-family:\"Segoe UI\",Roboto,sans-serif}.ds-nav-link{color:inherit;text-decoration:none;padding:10px 12px;border-radius:8px;font-size:.875rem;white-space:nowrap}.ds-nav-link:hover{background:color-mix(in srgb,currentColor 12%,transparent)}.ds-nav-link.ds-nav-active{background:var(--asl-nav-active,#fff);color:var(--asl-nav-ink,#1244a8);font-weight:650}.ds-nav-link:focus-visible{outline:2px solid var(--asl-header-ink,#fff);outline-offset:-3px}.ds-nav-active:focus-visible{outline-color:var(--asl-nav-ink,#1244a8)}.ds-nav-link:active{background:var(--asl-nav-active,#fff);color:var(--asl-nav-ink,#1244a8)}"
    },
    {
      "name": "Statut de budget",
      "kind": "chip",
      "refersTo": "status-light",
      "description": "Statut informatif du budget ; il ne représente pas un état de paiement.",
      "html": "<span class=\"ds-status\">Brouillon</span>",
      "css": ".ds-status{display:inline-block;font-family:\"Segoe UI\",Roboto,sans-serif;font-size:.75rem;padding:.3rem .6rem;background:var(--asl-tint,#e5efff);color:var(--asl-primary,#124dc5);border-radius:6px}"
    },
    {
      "name": "Panneau de détail sélectionné",
      "kind": "card",
      "refersTo": "panel-light",
      "description": "Surface de contexte liée à la sélection ; aucun montant fictif n’est affiché.",
      "html": "<section class=\"ds-detail\"><h3 class=\"ds-detail-title\">Détail du lot</h3><p class=\"ds-detail-text\">Les informations du lot sélectionné apparaissent ici.</p></section>",
      "css": ".ds-detail{background:var(--asl-surface,#fff);color:var(--asl-ink,#142b48);border:1px solid var(--asl-primary,#124dc5);border-radius:16px;padding:1.5rem;transition:box-shadow 180ms ease-out;font-family:\"Segoe UI\",Roboto,sans-serif;font-size:.875rem}.ds-detail-title{margin:0 0 1rem;font-size:1.5rem;font-weight:650;line-height:1.4}.ds-detail-text{line-height:1.55;max-width:75ch;overflow-wrap:anywhere}@media(prefers-reduced-motion:reduce){.ds-detail{transition:none}}"
    },
    {
      "name": "Contour de lot — fragment d’état",
      "kind": "custom",
      "description": "Fragment SVG schématique montrant le contour sélectionné et le focus. Ce fragment ne remplace pas le plan géographique des 42 lots.",
      "html": "<svg class=\"ds-map\" viewBox=\"0 0 180 100\" role=\"img\" aria-label=\"Fragment illustratif : lot soldé sélectionné\"><g class=\"ds-lot ds-selected\" tabindex=\"0\" role=\"button\" aria-label=\"Fragment de lot soldé\"><polygon points=\"20,20 155,15 160,75 25,80\"></polygon></g></svg>",
      "css": ".ds-map{display:block;max-width:100%;height:auto;background:#f8fbfd;border-radius:12px}.ds-lot{cursor:pointer}.ds-lot polygon{fill:var(--asl-map-settled,#a6ddba);transition:stroke-width 140ms ease-out,stroke 140ms ease-out;vector-effect:non-scaling-stroke}.ds-lot:hover polygon{stroke:var(--asl-map-focus,#124dc5);stroke-width:2px}.ds-selected polygon{stroke:var(--asl-map-focus,#124dc5);stroke-width:4px}.ds-lot:focus{outline:none}.ds-lot:focus polygon{stroke:var(--asl-map-focus,#124dc5);stroke-width:4px;stroke-dasharray:5 3}@media(prefers-reduced-motion:reduce){.ds-lot polygon{transition:none}}"
    },
    {
      "name": "Action destructive",
      "kind": "button",
      "refersTo": "button-warn-light",
      "description": "Variante pleine existante, avec couleurs explicitement reliées aux overrides Material 3. Libellé de démonstration de composant.",
      "html": "<button type=\"button\" class=\"ds-warn\">Supprimer</button>",
      "css": ".ds-warn{background:var(--asl-error,#a72d36);color:var(--mat-sys-on-error,var(--asl-on-error,#fff));border:0;border-radius:10px;height:40px;padding:0 24px;font:500 .875rem/1.25rem \"Segoe UI\",Roboto,sans-serif;letter-spacing:0;cursor:pointer}.ds-warn:hover{background:color-mix(in srgb,var(--asl-error,#a72d36),var(--asl-on-primary,#fff) 8%)}.ds-warn:focus-visible{outline:2px solid var(--asl-primary,#124dc5);outline-offset:3px}.ds-warn:active{background:color-mix(in srgb,var(--asl-error,#a72d36),var(--asl-on-primary,#fff) 12%)}.ds-warn:disabled{cursor:default;color:color-mix(in srgb,var(--asl-ink,#142b48) 38%,transparent);background:color-mix(in srgb,var(--asl-ink,#142b48) 12%,transparent)}"
    },
    {
      "name": "Action accent",
      "kind": "button",
      "refersTo": "button-accent-light",
      "description": "Variante pleine existante, avec couleurs explicitement reliées aux overrides Material 3. Libellé de démonstration de composant.",
      "html": "<button type=\"button\" class=\"ds-accent\">Enregistrer</button>",
      "css": ".ds-accent{background:var(--asl-raised,#f4f8fc);color:var(--asl-ink,#142b48);border:0;border-radius:10px;height:40px;padding:0 24px;font:500 .875rem/1.25rem \"Segoe UI\",Roboto,sans-serif;letter-spacing:0;cursor:pointer}.ds-accent:hover{background:color-mix(in srgb,var(--asl-raised,#f4f8fc),var(--asl-on-primary,#fff) 8%)}.ds-accent:focus-visible{outline:2px solid var(--asl-primary,#124dc5);outline-offset:3px}.ds-accent:active{background:color-mix(in srgb,var(--asl-raised,#f4f8fc),var(--asl-on-primary,#fff) 12%)}.ds-accent:disabled{cursor:default;color:color-mix(in srgb,var(--asl-ink,#142b48) 38%,transparent);background:color-mix(in srgb,var(--asl-ink,#142b48) 12%,transparent)}"
    }
  ],
  "narrative": {
    "northStar": "Bassin clair / Graphite",
    "overview": "Le monde choisi associe le cobalt, le bleu eau et les surfaces blanches de Bassin clair à une variante sombre Graphite. La navigation supérieure reprend Repères. Les surfaces unies, les séparations fines et une typographie sans empattement donnent une interface accueillante, précise et adaptée à la gestion de l’association.\n\nLa densité reste celle de Material 3 à zéro, avec des panneaux aérés et des listes compactes dans leur organisation. Les chiffres tabulaires facilitent la lecture des montants. La carte SVG constitue une matière fonctionnelle : sa couleur décrit les paiements, son contour décrit l’interaction.",
    "keyCharacteristics": [
      "Deux thèmes complets sous une même hiérarchie visuelle.",
      "Surfaces unies, bordures fines et angles adoucis selon le rôle.",
      "Navigation supérieure et commandes regroupées, repliées sur petit écran.",
      "Carte, recherche et détail liés sans effacer les états financiers."
    ],
    "rules": [
      {
        "name": "The Payment Color Rule",
        "body": "La sélection, les résultats de recherche et le focus ne remplacent jamais le remplissage financier d’un lot ; ils utilisent son contour.",
        "section": "colors"
      },
      {
        "name": "The Tabular Number Rule",
        "body": "Les tableaux et indicateurs financiers gardent des chiffres tabulaires pour stabiliser la comparaison des montants.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do utiliser les variables sémantiques `--asl-*` pour que les deux thèmes restent cohérents.",
      "Do garder la légende financière, les libellés d’état et le contour de sélection indépendants.",
      "Do conserver les chiffres tabulaires, les libellés accessibles et les états de chargement, vide et erreur distincts.",
      "Do vérifier le focus sur le bandeau, les menus et la carte dans les deux thèmes, puis le rendu sur ordinateur et mobile."
    ],
    "donts": [
      "Don't réutiliser le violet de trop-perçu comme couleur de sélection de la carte.",
      "Don't assombrir le fond géographique de la carte sans revoir ses routes et ses numéros.",
      "Don't remplacer le bouton + compact des listes par une action sans nom accessible ni infobulle.",
      "Don't présenter une extraction de code, un build ou une vignette du sidecar comme une validation visuelle de l’application."
    ]
  }
}
